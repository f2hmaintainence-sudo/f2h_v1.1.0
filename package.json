{
  "name": "f2h-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:api": "npm --workspace=apps/api run build",
    "build:web": "npm --workspace=apps/web run build",
    "build:customer-web": "./build-flutter.sh customer",
    "build:partner-web": "./build-flutter.sh partner",
    "deploy:customer-web": "./build-flutter.sh customer clean",
    "deploy:partner-web": "./build-flutter.sh partner clean",
    "deploy:all": "./build-flutter.sh both clean",
    "db:migrate": "npm --workspace=apps/api run db:migrate",
    "db:migrate:apply": "npm --workspace=apps/api run db:migrate:apply",
    "db:create-migration": "npm --workspace=apps/api run db:create-migration",
    "db:backup": "./scripts/db-backup.sh",
    "db:clone-prod-to-dev": "./scripts/db-clone-prod-to-dev.sh"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mobile/*"
  ]
}
