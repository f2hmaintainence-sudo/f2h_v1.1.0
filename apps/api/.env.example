# ─────────────────────────────────────────────────────────────────────────────
# F2H Fresh API — environment template.
#
# Key NAMES only. Never commit real values: the repository previously carried
# working JWT, session, and encryption keys in docker-compose.yml, and anything
# that ever used those must be treated as compromised and rotated.
#
# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5001

# ── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=postgresql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Alternative to DB_PASSWORD: a path to a file holding the password (Docker secrets).
DB_PASSWORD_FILE=
DB_POOL_SIZE=20
DB_APPLICATION_NAME=backend-api

# ── Redis (sessions live here — losing it logs everyone out) ─────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=f2h

# ── Auth ────────────────────────────────────────────────────────────────────
# Minimum 32 characters. Rotating this invalidates every existing session.
JWT_SECRET=
# Access tokens are short-lived; the refresh token carries the long session.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
SESSION_SECRET=

# ── Encryption (column-level PII) ───────────────────────────────────────────
# Rotating DATA_ENCRYPTION_KEY requires a re-encryption migration: read with the
# old key, write with the new, under a versioned key id.
ENCRYPTION_SECRET=
DATA_ENCRYPTION_KEY=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to send credentialed requests.
# REQUIRED in production; an empty value there denies every browser origin.
# Native mobile apps send no Origin header and are unaffected.
CORS_ORIGINS=http://localhost:3000

# ── Webhook secrets (no fallback — an unset value fails the request) ────────
F2H_CI_CD_UPLOAD_SECRET=
F2H_APP_UPDATE_WEBHOOK_SECRET=

# ── Scheduling ──────────────────────────────────────────────────────────────
# Set to false on API instances when cron handlers run in a dedicated worker.
ENABLE_CRON=true

# ── Third-party ─────────────────────────────────────────────────────────────
# The WEB OAuth client. Android and iOS set it as their `serverClientId`, so it
# is also the audience the API verifies id_tokens against.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Comma-separated: F2H ships two Android and two iOS apps (customer, delivery),
# each with its own OAuth client. Accepted as additional id_token audiences.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_MAPS_API_KEY=
# Absolute path to the Firebase Admin service-account JSON. Optional — the API
# reads `api_integrations_config` (firebase:admin) first and falls back to
# src/shared/secrets/firebasepushnotification.json.
FIREBASE_SERVICE_ACCOUNT_PATH=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
FAST2SMS_API_KEY=
FAST2SMS_ENDPOINT=
FAST2SMS_ROUTE=
