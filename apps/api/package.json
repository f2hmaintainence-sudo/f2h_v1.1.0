  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "npm run build && node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed:delivery": "ts-node -r tsconfig-paths/register src/scripts/seed-end-to-end.ts",
    "seed:delivery-run-demo": "ts-node -r tsconfig-paths/register src/scripts/seed-delivery-run-demo.ts",
    "seed:kuppam": "ts-node -r tsconfig-paths/register src/scripts/seed-kuppam.ts",
    "db:migrate": "ts-node -r tsconfig-paths/register src/scripts/run-migration.ts",
    "seed:firebase-admin": "ts-node -r tsconfig-paths/register src/scripts/seed-firebase-admin.ts"
  },
